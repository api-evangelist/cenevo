{
  "opencollection": "1.0.0",
  "info": {
    "name": "Labguru Antibodies Search API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get search results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/searches/global_search",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "number of results per page example: 20"
              },
              {
                "name": "term",
                "value": "",
                "type": "query",
                "description": "search term, example: ant"
              },
              {
                "name": "model",
                "value": "",
                "type": "query",
                "description": "filter by model name, example: Antibody"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "the default call is with page = 1"
              },
              {
                "name": "meta",
                "value": "",
                "type": "query",
                "description": "show summarized data information - true/false"
              }
            ]
          },
          "docs": "Get search results"
        }
      ]
    }
  ],
  "bundled": true
}