          "request": {
            "name": "Add item",
            "description": {
              "content": "This endpoint allows for adding standard or custom commercial items to the shopping list. It supports two types of item additions:\n1. **Standard Item Addition**: Using the `addItem` schema for predefined commercial item types.\n\n2. **Custom Item Addition**: Using the `addCustomItem` schema for user-defined commercial items and collections.\n\nEnsure the request body matches the structure defined in the referenced schemas for successful operation.\n",
              "type": "text/plain"
            },
            "url": {
