            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/comments",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "the default call is with page = 1"
              },
              {
                "name": "meta",
                "value": "",
                "type": "query",
                "description": " show summarized data information - true/false"
              }
            ]
          },
          "docs": "List all comments in your account"
        },
        {
          "info": {
            "name": "Creates a comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/comments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a comment"
        },
        {
          "info": {
            "name": "Get comment by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/comments/:id",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "comment id"
              }
            ]
          },
          "docs": "Get comment by id"
        },
        {
          "info": {
            "name": "Delete comment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/comments/:id",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "comment id"
              }
            ]
          },
          "docs": "Delete comment"
        }
      ]
    }
  ],
  "bundled": true
